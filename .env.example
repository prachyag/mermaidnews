# ฐานข้อมูล — dev ใช้ไฟล์ local, production ชี้ไป Turso
# DATABASE_URL=file:./data/dev.db
# DATABASE_URL=libsql://<your-db>.turso.io
# DATABASE_AUTH_TOKEN=<turso auth token>

# เฟส 2: Gemini API (ขอ key ฟรีจาก https://aistudio.google.com)
# GEMINI_API_KEY=
# override โมเดลได้ (default: gemini-flash-latest)
# GEMINI_MODEL=
# จำนวนข่าวที่รวมส่งให้ AI ต่อ 1 request (default: 5)
# มากขึ้น = ประหยัดโควตา แต่เสี่ยงโมเดลตอบไม่ครบ/output โดนตัด และถ้าพังก็พังทั้งชุด
# GEMINI_BATCH_SIZE=

# งบ "คิดก่อนตอบ" ต่อ 1 request (default: 128)
# ⚠️ ห้ามตั้งเป็น 0 — รุ่นใหม่ของ Gemini ไม่ให้ปิด thinking สนิท จะได้ 400 INVALID_ARGUMENT ทุกคำขอ
# ตั้ง -1 = ให้โมเดลคิดอิสระ (ช้าลงมากและเสี่ยง output โดนตัด ไม่แนะนำ)
# GEMINI_THINKING_BUDGET=

# เพดาน output ต่อ 1 request (default: 32768) — นับรวม thinking token ด้วย
# ถ้าตั้งต่ำเกินจะเจอ JSON ถูกตัดกลางคัน หรือได้ข่าวที่ relevant แต่ไม่มีแคปชัน
# GEMINI_MAX_OUTPUT_TOKENS=

# secret สำหรับเซ็น session token ของระบบล็อกอิน — production ต้องตั้งเป็นค่าสุ่มยาว ๆ
# สร้างได้ด้วย: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# AUTH_SECRET=

# ปิดรับสมัครสมาชิกใหม่ (ตั้งเป็น false เพื่อปิด) — บัญชีแรกของระบบสมัครได้เสมอถึงจะปิดไว้
# ALLOW_REGISTRATION=false

# จำนวนแถวสูงสุดของ audit log ผู้ดูแลระบบ (default: 2000) — เกินกว่านี้แถวเก่าสุดถูกลบอัตโนมัติ
# AUDIT_LOG_MAX_ENTRIES=2000

# จำนวนแถวสูงสุดของสถิติการเรียก AI (default: 2000) — หมุนเวียนอัตโนมัติเหมือน audit log
# ดูสถิติได้ที่หน้า "จัดการผู้ใช้" หัวข้อ "สุขภาพการเรียก AI" หรือ GET /api/ai-stats
# AI_STATS_MAX_ENTRIES=2000

# เฟส 4: Facebook
# Page Access Token ไม่ได้อยู่ที่นี่แล้ว — ใส่ต่อหัวข้อในหน้า "จัดการหัวข้อ" ของแต่ละบัญชี
# (override เวอร์ชัน Graph API ได้ถ้าจำเป็น)
# FB_GRAPH_VERSION=v23.0
